# Copying this file does NOT create a valid key. Prefer pnpm env:init.
API_KEYS=owner:REPLACE_WITH_A_RANDOM_SECRET_OF_AT_LEAST_32_CHARACTERS
PUBLIC_BASE_URL=http://localhost:8080
NODE_ENV=development
HOST=127.0.0.1
PORT=8080
DATA_DIR=./data
VANTAGE_LABEL=self-hosted-single-node
DOMAIN=
ALLOW_HTTP=false
# Exact normalized hostnames, comma-separated. Empty permits policy-screened public hosts.
ALLOWED_TARGET_HOSTS=
# Add your own public management addresses/subnets here.
DENIED_CIDRS=
PROBE_TIMEOUT_MS=8000
MAX_RESPONSE_BYTES=262144
MAX_REDIRECTS=3
MAX_CONCURRENT_PROBES=4
MAX_CLIENT_CONCURRENCY=2
REQUESTS_PER_MINUTE=120
PROBES_PER_MINUTE=20
EVIDENCE_TTL_SECONDS=86400
MAX_EVIDENCE_RECORDS=2000
MAX_CLIENT_EVIDENCE_RECORDS=200
